<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <!-- Se puede sobreescribir con -DlogDir=ruta/absoluta -->
        <Property name="logDir">${sys:logDir:-log}</Property>
        <Property name="appName">gateway-simulator</Property>
    </Properties>

    <Appenders>
        <!-- Consola -->
        <Console name="ConsoleAppender" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
        </Console>

        <!-- Archivo diario con rotacion -->
        <RollingFile name="DailyRollingFile"
                     fileName="${logDir}/${appName}-daily.log"
                     filePattern="${logDir}/${appName}-daily-%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <OnStartupTriggeringPolicy />
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- Archivo solo errores -->
        <RollingFile name="ErrorFile"
                     fileName="${logDir}/${appName}-errors.log"
                     filePattern="${logDir}/${appName}-errors-%d{yyyy-MM-dd}.log">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Librerias externas: solo WARN/ERROR -->
        <Logger name="org.apache"               level="WARN"/>
        <Logger name="org.springframework"      level="WARN"/>
        <Logger name="com.fasterxml.jackson"    level="WARN"/>
        <Logger name="sun.awt.shell"            level="ERROR"/>

        <!-- Logger raiz: INFO a consola + archivo diario + archivo errores -->
        <Root level="INFO">
            <AppenderRef ref="ConsoleAppender"/>
            <AppenderRef ref="DailyRollingFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Root>
    </Loggers>
</Configuration>